{
	"name": "portfolio-creator",
	"private": true,
	"version": "1.2.0",
	"type": "module",
	"description": "Fill in a form, get a portfolio. Generates settings.json for the Life-Experimentalist portfolio template.",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/Life-Experimentalist/portfolio-creator.git"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build && node scripts/generate-seo.js && node scripts/generate-sw.js",
		"preview": "vite preview",
